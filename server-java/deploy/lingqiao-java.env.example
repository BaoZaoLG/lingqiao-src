# Shadow sidecar: loopback-only and no Go-to-Java forwarding.
JAVA_SERVER_ADDRESS=127.0.0.1
JAVA_SERVER_PORT=49001
JAVA_DATA_DIR=/opt/injector-server/data
JAVA_DB_URL=jdbc:sqlite:file:/opt/injector-server/data/lingqiao.db?mode=ro
# Shared module/auth datasource. Keep mode=ro until the first explicit write cutover.
JAVA_WRITE_DB_URL=jdbc:sqlite:file:/opt/injector-server/data/lingqiao.db?mode=ro
JAVA_EXAM_ENABLED=true
JAVA_AUDIT_ENABLED=true
JAVA_SCRIPTS_ENABLED=true
JAVA_CUTOVER_ENABLED=false
